{
  "$description": "Generated from Figma effect styles by scripts/import-figma.mjs — edit Figma and re-import, or edit here and update Figma by hand (effect styles are not variables, so Token Nexus cannot sync them).",
  "shadow": {
    "100": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000038",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "#00000033",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "Button\nWidget\nChip\nDrag & drop item\nInput control -> Focused state (checkbox / radio button)",
      "$extensions": {
        "com.figma": {
          "effectStyle": "Shadow/100"
        },
        "com.certara": {
          "dark": [
            {
              "color": "#ffffff33",
              "offsetX": "0px",
              "offsetY": "0px",
              "blur": "0px",
              "spread": "1px"
            }
          ]
        }
      }
    },
