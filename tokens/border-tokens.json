{
  "border": {
    "radius": {
      "none": {
        "$value": 0,
        "$type": "borderRadius"
      },
      "xs": {
        "$value": 2,
        "$type": "borderRadius"
      },
      "sm": {
        "$value": 3,
        "$type": "borderRadius"
      },
      "md": {
        "$value": 4,
        "$type": "borderRadius"
      },
      "lg": {
        "$value": 6,
        "$type": "borderRadius"
      },
      "xl": {
        "$value": 8,
        "$type": "borderRadius"
      },
      "full": {
        "$value": 9999,
        "$type": "borderRadius"
      }
    },
    "width": {
      "unit": {
        "0": {
          "$value": 0,
          "$type": "strokeWidth"
        },
        "1": {
          "$value": 1,
          "$type": "strokeWidth"
        },
        "2": {
          "$value": 2,
          "$type": "strokeWidth"
        },
        "3": {
          "$value": 3,
          "$type": "strokeWidth"
        },
        "4": {
          "$value": 4,
          "$type": "strokeWidth"
        },
        "5": {
          "$value": 5,
          "$type": "strokeWidth"
        }
      },
      "default": {
        "$value": "{border.width.unit.1}",
        "$type": "strokeWidth"
      },
      "focused": {
        "$value": "{border.width.unit.4}",
        "$type": "strokeWidth"
      },
      "highlight": {
        "$value": "{border.width.unit.2}",
        "$type": "strokeWidth"
      },
      "error": {
        "$value": "{border.width.unit.2}",
        "$type": "strokeWidth"
      },
      "unread": {
        "$value": "{border.width.unit.5}",
        "$type": "strokeWidth"
      }
    }
  }
}
